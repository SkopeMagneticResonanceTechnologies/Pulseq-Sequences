# Format of RF events:
# id amplitude mag_id phase_id time_shape_id delay freq phase
# ..        Hz   ....     ....          ....    us   Hz   rad
[RF]
1       502.45 7 8 0 100 2500 -15.708
2      493.728 9 10 0 100 1250 -15.708
3       502.45 7 8 0 100 -2500 15.708
4      493.728 9 10 0 100 -1250 15.708

# Format of arbitrary gradients:
#   time_shape_id of 0 means default timing (stepping with grad_raster starting at 1/2 of grad_raster)
# id amplitude amp_shape_id time_shape_id delay
# ..      Hz/m       ..         ..          us
[GRADIENTS]
10      -194805 1 2 650
11      -194805 3 4 0
12      -194805 5 6 0

# Format of trapezoid gradients:
# id amplitude rise flat fall delay
# ..      Hz/m   us   us   us    us
[TRAP]
 1      -666667  90 2000  90  10
 2  2.32222e+06 300    0 300   0
 3  1.48553e+06 190    0 190   0
 4      -990350 130  440 130   0
 5       990350 130  440 130   0
 6           -0 2800 3900 2800   0
 7            0 2800 3900 2800   0
 8      -333333  50 4000  50  50
 9       479798  60  480  60   0
13  7.03598e+06 2800 3900 2800   0
14  5.91653e+06 2800 3900 2800   0

# Format of ADC events:
# id num dwell delay freq phase
# ..  ..    ns    us   Hz   rad
[ADC]
1 272 2200 51 0 0

