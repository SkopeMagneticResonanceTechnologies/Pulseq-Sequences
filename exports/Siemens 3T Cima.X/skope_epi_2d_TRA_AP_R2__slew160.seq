# Format of RF events:
# id amplitude mag_id phase_id time_shape_id delay freq phase
# ..        Hz   ....     ....          ....    us   Hz   rad
[RF]
1       502.45 7 8 0 100 -49000 307.876
2       502.45 7 8 0 100 -42000 263.894
3       502.45 7 8 0 100 -35000 219.911
4       502.45 7 8 0 100 -28000 175.929
