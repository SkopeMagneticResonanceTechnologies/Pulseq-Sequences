12       502.45 7 8 0 100 28000 -175.929
13       502.45 7 8 0 100 35000 -219.911
14       502.45 7 8 0 100 42000 -263.894
15       502.45 7 8 0 100 49000 -307.876

# Format of arbitrary gradients:
#   time_shape_id of 0 means default timing (stepping with grad_raster starting at 1/2 of grad_raster)
# id amplitude amp_shape_id time_shape_id delay
# ..      Hz/m       ..         ..          us
[GRADIENTS]
7      -200000 1 2 840
8      -200000 3 4 0
9      -200000 5 6 0

# Format of trapezoid gradients:
# id amplitude rise flat fall delay
# ..      Hz/m   us   us   us    us
[TRAP]
 1       666667 100 2000 100   0
 2 -2.12121e+06 330    0 330   0
 3 -1.62149e+06 250    0 250   0
 4   1.1419e+06 170  540 170   0
 5  -1.1419e+06 170  540 170   0
 6       709091 110  440 110   0

# Format of ADC events:
# id num dwell delay freq phase
# ..  ..    ns    us   Hz   rad
[ADC]
1 184 4300 44 0 0

