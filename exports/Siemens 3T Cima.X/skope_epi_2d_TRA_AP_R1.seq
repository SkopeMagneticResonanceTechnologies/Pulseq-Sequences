# Format of arbitrary gradients:
#   time_shape_id of 0 means default timing (stepping with grad_raster starting at 1/2 of grad_raster)
# id amplitude amp_shape_id time_shape_id delay
# ..      Hz/m       ..         ..          us
[GRADIENTS]
7      -125000 1 2 530
8      -125000 3 4 0
9      -125000 5 6 0

# Format of trapezoid gradients:
# id amplitude rise flat fall delay
# ..      Hz/m   us   us   us    us
[TRAP]
 1       666667  90 2000  90  10
 2 -1.33974e+06 180  340 180   0
 3 -1.19572e+06 170    0 170   0
 4       945455 130  300 130   0
 5      -945455 130  300 130   0
 6       295455  40  620  40   0

# Format of ADC events:
# id num dwell delay freq phase
# ..  ..    ns    us   Hz   rad
[ADC]
1 96 5200 30 0 0

