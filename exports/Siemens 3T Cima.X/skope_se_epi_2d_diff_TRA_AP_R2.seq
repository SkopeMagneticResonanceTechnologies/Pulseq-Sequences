# Format of RF events:
# id amplitude mag_id phase_id time_shape_id delay freq phase
# ..        Hz   ....     ....          ....    us   Hz   rad
[RF]
1       502.45 6 7 0 100 -2500 15.708
2      493.728 8 9 0 100 -1250 15.708
3       502.45 6 7 0 100 7500 -47.1239
4      493.728 8 9 0 100 3750 -47.1239
5       502.45 6 7 0 100 -7500 47.1239
6      493.728 8 9 0 100 -3750 47.1239
7       502.45 6 7 0 100 2500 -15.708
8      493.728 8 9 0 100 1250 -15.708

# Format of arbitrary gradients:
#   time_shape_id of 0 means default timing (stepping with grad_raster starting at 1/2 of grad_raster)
# id amplitude amp_shape_id time_shape_id delay
# ..      Hz/m       ..         ..          us
[GRADIENTS]
8      -151515 1 2 540
9      -151515 3 4 0
10      -151515 5 2 0

# Format of trapezoid gradients:
# id amplitude rise flat fall delay
# ..      Hz/m   us   us   us    us
[TRAP]
 1      -666667  90 2000  90  10
 2  2.32222e+06 300    0 300   0
 3      -333333  50 4000  50  50
 4 -1.37449e+06 170    0 170   0
 5   1.0385e+06 130  320 130   0
 6  -1.0385e+06 130  320 130   0
 7       396694  50  500  50   0
11      -582751  80 1480  80   0
12      -871460 110 1420 110   0
13  2.01551e+06 400 18750 400   0
14            0 400 18750 400   0
15           -0 400 18750 400   0

# Format of ADC events:
# id num dwell delay freq phase
# ..  ..    ns    us   Hz   rad
[ADC]
1 236 2100 42 0 0

